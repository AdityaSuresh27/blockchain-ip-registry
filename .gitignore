# ==============================================================================
# Blockchain IP Registry - Root Git Ignore Configuration
# Protects against leaking secrets, credentials, node_modules, and cache files.
# ==============================================================================

# --- Node.js Dependencies ---
node_modules/
*/node_modules/
backend/node_modules/
blockchain/node_modules/
frontend/node_modules/

# --- Environment & Secret Leak Prevention ---
.env
.env.*
*.env
*.pem
*.key
*.keystore
secrets.json
private_keys.txt

# --- Hardhat & Solidity Artifacts ---
blockchain/cache/
blockchain/artifacts/
cache/
artifacts/
typechain/
typechain-types/

# --- Next.js Build Outputs & Caches ---
.next/
frontend/.next/
frontend/out/
frontend/build/
.vercel/

# --- Local IPFS Uploaded Files (Simulated Storage) ---
# Preserve the folder structure with .gitkeep, but ignore uploaded user payload files
frontend/public/ipfs/*
!frontend/public/ipfs/.gitkeep
frontend/storage/ipfs/*
!frontend/storage/ipfs/.gitkeep

# --- Debug & Process Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# --- Temporary / Scratch Files ---
pptx_extracted.txt
